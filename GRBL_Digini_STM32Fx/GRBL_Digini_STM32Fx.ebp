	<Project>
		<Option title="GRBL_Digini_STM32Fx" />
		<Option compiler="armgcc_eb" />
		<Option extended_obj_names="1" />
		<Build>
			<Target title="Debug">
				<Option output="bin\Debug\grbl.elf" />
				<Option object_output="obj\Debug\" />
				<Option type="0" />
				<Option create_hex="1" />
				<Option compiler="armgcc_eb" />
				<Option projectDeviceOptionsRelation="0" />
				<Device>
					<Add option="$device=cortex-m7" />
					<Add option="$fpu=fpv4-sp-d16" />
					<Add option="$lscript=./stm32f746x_flash.ld" />
					<Add option="$stack=0x0800" />
					<Add option="$heap=0x2000" />
				</Device>
				<Compiler>
					<Add option="-std=gnu11" />
					<Add option="-Wcomment" />
					<Add option="-Wall" />
					<Add option="-fno-schedule-insns2" />
					<Add option="-fshort-enums" />
					<Add option="-fdata-sections" />
					<Add option="-ffunction-sections" />
					<Add option="-O0" />
					<Add option="-g2" />
					<Add symbol="DEBUG" />
				</Compiler>
				<Cpp>
					<Add option="-mfloat-abi=hard" />
					<Add option="-std=gnu++11" />
					<Add option="-Wcomment" />
					<Add option="-pedantic-errors" />
					<Add option="-Wall" />
					<Add option="-g3" />
				</Cpp>
				<Assembler>
					<Add option="-Wa,--keep-locals" />
					<Add option="-Wa,--gdwarf-2" />
				</Assembler>
				<Linker>
					<Add option="-lstdc++" />
					<Add option="-eb_use_semi" />
					<Add option="-Wl,--cref" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin\Release\grbl.elf" />
				<Option object_output="obj\Release\" />
				<Option type="0" />
				<Option create_hex="1" />
				<Option compiler="armgcc_eb" />
				<Option projectDeviceOptionsRelation="0" />
				<Compiler>
					<Add option="-fdata-sections" />
					<Add option="-ffunction-sections" />
					<Add option="-O2" />
					<Add option="-g2" />
				</Compiler>
				<Assembler>
					<Add option="-Wa,--no-warn" />
				</Assembler>
			</Target>
		</Build>
		<Device>
			<Add option="$device=cortex-m7" />
			<Add option="$fpu=fpv4-sp-d16" />
			<Add option="$lscript=./stm32f746x_flash.ld" />
			<Add option="$stack=0x0400" />
			<Add option="$heap=0x5000" />
		</Device>
